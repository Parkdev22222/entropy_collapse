[36m(TaskRunner pid=2357500)[0m import math
[36m(TaskRunner pid=2357500)[0m 
[36m(TaskRunner pid=2357500)[0m # Coefficients
[36m(TaskRunner pid=2357500)[0m a = 324
[36m(TaskRunner pid=2357500)[0m b = -468
[36m(TaskRunner pid=2357500)[0m 
[36m(TaskRunner pid=2357500)[0m # Calculate the maximum value of a*cos(theta) + b*sin(theta)
[36m(TaskRunner pid=2357500)[0m max_real_part = math.sqrt(a**2 + b**2)
