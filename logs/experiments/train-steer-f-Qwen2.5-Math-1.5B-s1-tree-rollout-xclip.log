[36m(TaskRunner pid=2357500)[0m = 300\cos\theta - 468\sin\theta + 4i(75\sin\theta + 117\cos\theta) + 24\cos\theta - 36\sin\theta + i(36\cos\theta - 24\sin\theta)
[36m(TaskRunner pid=2357500)[0m \]
[36m(TaskRunner pid=2357500)[0m \[
[36m(TaskRunner pid=2357500)[0m = (300\cos\theta + 24\cos\theta - 468\sin\theta - 36\sin\theta) + i(4(75\sin\theta + 117\cos\theta) + 36\cos\theta - 24\sin\theta)
[36m(TaskRunner pid=2357500)[0m \]
[36m(TaskRunner pid=2357500)[0m \[
