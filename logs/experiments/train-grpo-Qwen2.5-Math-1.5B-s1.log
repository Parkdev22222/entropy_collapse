[36m(TaskRunner pid=49749)[0m    \]
[36m(TaskRunner pid=49749)[0m    \[
[36m(TaskRunner pid=49749)[0m    = 300\cos\theta - 468\sin\theta + i(468\cos\theta + 300\sin\theta)
[36m(TaskRunner pid=49749)[0m    \]
[36m(TaskRunner pid=49749)[0m    \[
[36m(TaskRunner pid=49749)[0m    \frac{96 + 144i}{z} = \frac{96 + 144i}{4(\cos\theta + i\sin\theta)} = \frac{96 + 144i}{4} \cdot \frac{\cos\theta - i\sin\theta}{\cos^2\theta + \sin^2\theta} = \frac{24 - 36i}{1} \cdot (\cos\theta - i\sin\theta)
[36m(TaskRunner pid=49749)[0m    \]
[36m(TaskRunner pid=49749)[0m    \[
[36m(TaskRunner pid=49749)[0m    = 24\cos\theta + 36\sin\theta - i(24\sin\theta - 36\cos\theta)
[36m(TaskRunner pid=49749)[0m    \]
