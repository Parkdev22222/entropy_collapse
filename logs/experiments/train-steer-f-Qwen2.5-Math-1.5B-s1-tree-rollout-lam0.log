[36m(TaskRunner pid=475120)[0m import numpy as np
[36m(TaskRunner pid=475120)[0m 
[36m(TaskRunner pid=475120)[0m # Define the coefficients
[36m(TaskRunner pid=475120)[0m a = 324
[36m(TaskRunner pid=475120)[0m b = -432
[36m(TaskRunner pid=475120)[0m 
[36m(TaskRunner pid=475120)[0m # Calculate the maximum value of the expression
[36m(TaskRunner pid=475120)[0m max_value = np.sqrt(a**2 + b**2)
