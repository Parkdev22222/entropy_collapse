[36m(TaskRunner pid=169544)[0m import numpy as np
[36m(TaskRunner pid=169544)[0m 
[36m(TaskRunner pid=169544)[0m # Define the coefficients
[36m(TaskRunner pid=169544)[0m a = 324
[36m(TaskRunner pid=169544)[0m b = -432
[36m(TaskRunner pid=169544)[0m 
