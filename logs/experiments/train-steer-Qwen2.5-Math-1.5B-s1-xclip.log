[36m(TaskRunner pid=3068817)[0m ```python
[36m(TaskRunner pid=3068817)[0m import numpy as np
[36m(TaskRunner pid=3068817)[0m 
[36m(TaskRunner pid=3068817)[0m # Define the coefficients
[36m(TaskRunner pid=3068817)[0m a = 75
[36m(TaskRunner pid=3068817)[0m b = 117
[36m(TaskRunner pid=3068817)[0m c = 96
[36m(TaskRunner pid=3068817)[0m d = 144
[36m(TaskRunner pid=3068817)[0m 
[36m(TaskRunner pid=3068817)[0m # Define the expression for the real part
[36m(TaskRunner pid=3068817)[0m def real_part(theta):
[36m(TaskRunner pid=3068817)[0m     return 324 * np.cos(theta) - 432 * np.sin(theta)
[36m(TaskRunner pid=3068817)[0m 
