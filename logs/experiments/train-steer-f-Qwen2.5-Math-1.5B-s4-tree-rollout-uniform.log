[36m(TaskRunner pid=2227203)[0m \[
[36m(TaskRunner pid=2227203)[0m = 4(75\cos\theta + 75i\sin\theta + 117i\cos\theta - 117\sin\theta) + \frac{96\cos\theta + 96i\sin\theta + 144i\cos\theta + 144\sin\theta}{4}
[36m(TaskRunner pid=2227203)[0m \]
