[36m(TaskRunner pid=3939378)[0m # We know 4 = 2^2, so 4^x = (2^2)^x = 2^(2x)
[36m(TaskRunner pid=3939378)[0m # Therefore, 2^8 = 2^(2x)
[36m(TaskRunner pid=3939378)[0m # This implies 8 = 2x, so x = 8 / 2
