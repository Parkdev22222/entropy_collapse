[36m(TaskRunner pid=3899417)[0m # Therefore, 2^8 = 2^(2x)
[36m(TaskRunner pid=3899417)[0m # This implies 8 = 2x, so x = 8 / 2
[36m(TaskRunner pid=3899417)[0m 
[36m(TaskRunner pid=3899417)[0m x = 8 / 2
