[36m(TaskRunner pid=1488992)[0m b = -432
[36m(TaskRunner pid=1488992)[0m 
[36m(TaskRunner pid=1488992)[0m # Calculate the amplitude R
[36m(TaskRunner pid=1488992)[0m R = np.sqrt(a**2 + b**2)
[36m(TaskRunner pid=1488992)[0m 
[36m(TaskRunner pid=1488992)[0m # The maximum value of the real part expression
[36m(TaskRunner pid=1488992)[0m max_real_part = R
