[36m(TaskRunner pid=1496695)[0m b = -432
[36m(TaskRunner pid=1496695)[0m 
[36m(TaskRunner pid=1496695)[0m # Calculate the magnitude R
[36m(TaskRunner pid=1496695)[0m R = np.sqrt(a**2 + b**2)
[36m(TaskRunner pid=1496695)[0m print(R)
