[36m(TaskRunner pid=67616)[0m \]
[36m(TaskRunner pid=67616)[0m \[
[36m(TaskRunner pid=67616)[0m = 4(75\cos\theta - 117\sin\theta + i(75\sin\theta + 117\cos\theta)) + \frac{96 + 144i}{4(\cos\theta + i\sin\theta)}
[36m(TaskRunner pid=67616)[0m \]
[36m(TaskRunner pid=67616)[0m \[
[36m(TaskRunner pid=67616)[0m = 4(75\cos\theta - 117\sin\theta + i(75\sin\theta + 117\cos\theta)) + \frac{(96 + 144i)(\cos\theta - i\sin\theta)}{4(\cos^2\theta + \sin^2\theta)}
[36m(TaskRunner pid=67616)[0m \]
