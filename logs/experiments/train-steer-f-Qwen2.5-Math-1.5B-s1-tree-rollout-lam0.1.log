[36m(TaskRunner pid=1009280)[0m # Coefficients
[36m(TaskRunner pid=1009280)[0m a = 324
[36m(TaskRunner pid=1009280)[0m b = 432
[36m(TaskRunner pid=1009280)[0m 
[36m(TaskRunner pid=1009280)[0m # Maximum value of the expression
