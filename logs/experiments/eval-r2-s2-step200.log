[36m(TaskRunner pid=303109)[0m 
[36m(TaskRunner pid=303109)[0m # The image diameter is the same as the planet's diameter because the magnification factor is not specified
[36m(TaskRunner pid=303109)[0m # and we assume the magnification is such that the image diameter is proportional to the focal length
[36m(TaskRunner pid=303109)[0m diameter_image = diameter_planet  # in meters
[36m(TaskRunner pid=303109)[0m 
