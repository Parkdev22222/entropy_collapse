[36m(TaskRunner pid=228462)[0m 
[36m(TaskRunner pid=228462)[0m # Define the function R(theta)
[36m(TaskRunner pid=228462)[0m def R(theta):
[36m(TaskRunner pid=228462)[0m     return -(300 * np.cos(theta) - 468 * np.sin(theta) + 24 + 48 * np.sin(theta)**2)
[36m(TaskRunner pid=228462)[0m 
