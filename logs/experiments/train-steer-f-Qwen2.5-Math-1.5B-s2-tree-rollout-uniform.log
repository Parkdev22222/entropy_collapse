[36m(TaskRunner pid=228462)[0m     return max_real
[36m(TaskRunner pid=228462)[0m 
[36m(TaskRunner pid=228462)[0m # Calculate the maximum real part
[36m(TaskRunner pid=228462)[0m max_real = max_real_part(a, b, z_magnitude)
