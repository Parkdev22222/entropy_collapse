[36m(TaskRunner pid=228462)[0m import cmath
[36m(TaskRunner pid=228462)[0m import math
[36m(TaskRunner pid=228462)[0m 
[36m(TaskRunner pid=228462)[0m # Define the complex numbers
[36m(TaskRunner pid=228462)[0m a = 75 + 117j
[36m(TaskRunner pid=228462)[0m b = 96 + 144j
[36m(TaskRunner pid=228462)[0m z_magnitude = 4
[36m(TaskRunner pid=228462)[0m 
[36m(TaskRunner pid=228462)[0m # Function to find the maximum real part
[36m(TaskRunner pid=228462)[0m def max_real_part(a, b, z_magnitude):
[36m(TaskRunner pid=228462)[0m     max_real = -float('inf')
[36m(TaskRunner pid=228462)[0m     for theta in range(0, 360):
[36m(TaskRunner pid=228462)[0m         theta_rad = math.radians(theta)
[36m(TaskRunner pid=228462)[0m         z = z_magnitude * (cmath.cos(theta_rad) + 1j * cmath.sin(theta_rad))
[36m(TaskRunner pid=228462)[0m         z_inv = 1 / z
[36m(TaskRunner pid=228462)[0m         value = a * z + b * z_inv
