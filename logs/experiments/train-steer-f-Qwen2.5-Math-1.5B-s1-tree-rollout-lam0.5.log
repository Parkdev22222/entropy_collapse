[36m(TaskRunner pid=1724981)[0m \]
[36m(TaskRunner pid=1724981)[0m 
[36m(TaskRunner pid=1724981)[0m \[
[36m(TaskRunner pid=1724981)[0m = (300\cos\theta - 468\sin\theta + 24\cos\theta) + i(468\cos\theta + 300\sin\theta + 36\cos\theta - 24\sin\theta)
[36m(TaskRunner pid=1724981)[0m \]
