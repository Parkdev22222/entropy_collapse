[36m(TaskRunner pid=65294)[0m a = 324
[36m(TaskRunner pid=65294)[0m b = -432
[36m(TaskRunner pid=65294)[0m 
[36m(TaskRunner pid=65294)[0m # Calculate the maximum value of the real part
