+        for _ in range(4):  # unwrap FSDP / compile / PEFT layers
+            if hasattr(module, "get_output_embeddings"):
+                emb = module.get_output_embeddings()
+                if emb is not None:
+                    return emb
+            module = getattr(module, "module", module)
