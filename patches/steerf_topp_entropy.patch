@@ -75,6 +76,80 @@ def renyi2_from_logits(logits: torch.Tensor) -> torch.Tensor:
 # why the calibration JSON is stamped and checked.
 ENTROPY_FNS = {"shannon": entropy_from_logits, "renyi2": renyi2_from_logits}
 
+_TINY = 1e-30
+
+
+def _entropy_from_probs(probs: torch.Tensor, entropy_kind: str) -> torch.Tensor:
+    """Same functionals as ``ENTROPY_FNS`` but reading a probability vector.
+
+    Needed by the nucleus path: masking dropped tokens to ``-inf`` in logit
+    space makes Shannon's ``(probs * logits).sum()`` evaluate ``0 * -inf``,
+    which is NaN rather than the 0 the limit gives.  Reading probabilities
+    directly sidesteps that -- a dropped token contributes exactly 0 to both
+    functionals, and ``clamp_min`` only guards ``log(0)`` for entries whose
+    coefficient is already 0.
+    """
+    if entropy_kind == "renyi2":
+        return -torch.log((probs * probs).sum(dim=-1).clamp_min(_TINY))
+    return -(probs * torch.log(probs.clamp_min(_TINY))).sum(dim=-1)
+
+
+def entropy_of_logits(logits: torch.Tensor, entropy_kind: str = "shannon",
+                      top_p: float = 1.0, k_cap: int = 4096) -> torch.Tensor:
+    """One entry point for every (kind, top_p) combination.
+
+    Phase 1's measured ground truth and the forecast read-out must apply the
+    identical transform, or the calibration fits one quantity onto another.
+    """
+    if entropy_kind not in ENTROPY_FNS:
+        raise ValueError(f"entropy_kind must be one of {sorted(ENTROPY_FNS)}, got {entropy_kind!r}")
+    if top_p >= 1.0:
+        return ENTROPY_FNS[entropy_kind](logits)
+    return _entropy_from_probs(nucleus_probs(logits, top_p, k_cap), entropy_kind)
+
+
+def nucleus_probs(logits: torch.Tensor, top_p: float,
+                  k_cap: int = 4096) -> torch.Tensor:
+    """Renormalised top-p nucleus of ``logits``, as probabilities.
+
+    The smallest set of tokens whose cumulative probability reaches ``top_p``,
+    rescaled to sum to 1.  Order is not restored: every consumer here is a
+    permutation-invariant sum, so the un-sort is skipped.
+
+    ``k_cap`` bounds the sort to the top ``k_cap`` logits instead of all
+    ``V`` (a full sort of ``[chunk, 151936]`` costs a float copy plus an
+    int64 index tensor -- several GB at the default chunk size, on top of the
+    logits already resident).  For a trained LM the nucleus at ``top_p <=
+    0.99`` is orders of magnitude smaller than 4096; if it ever saturates the
+    cap the result would be silently truncated, so that raises instead.
+    """
+    if not (0.0 < top_p <= 1.0):
+        raise ValueError(f"top_p must be in (0, 1], got {top_p}")
+    if top_p >= 1.0:
+        # Not merely an optimisation. The `(cum - probs) < top_p` test drops
+        # tokens once the cumulative sum saturates at 1.0 in float, which for a
+        # 500-way distribution already excludes the last handful (measured:
+        # 6/500, first at p=2.5e-08, below float32 eps). They contribute 0 to
+        # either functional so no number moves, but "top_p=1.0" would silently
+        # stop meaning "the whole distribution". Return the plain softmax.
+        return torch.softmax(logits, dim=-1)
+    k = min(int(k_cap), logits.shape[-1])
+    top_logits, _ = torch.topk(logits, k, dim=-1)
+    probs = torch.softmax(top_logits, dim=-1)
+    cum = probs.cumsum(dim=-1)
+    # Keep every token whose predecessors had not yet reached top_p, so the
+    # token that crosses the threshold is included -- the standard nucleus.
+    keep = (cum - probs) < top_p
+    keep[..., 0] = True  # never return an empty nucleus
+    if k < logits.shape[-1] and bool(keep[..., -1].any()):
+        raise ValueError(
+            f"nucleus hit the k_cap={k} bound at top_p={top_p}; the result would "
+            "be silently truncated. Raise steerf_entropy_top_k_cap (memory cost "
+            "is linear in it) or use a smaller top_p."
+        )
+    probs = probs * keep
+    return probs / probs.sum(dim=-1, keepdim=True).clamp_min(_TINY)
+
 
