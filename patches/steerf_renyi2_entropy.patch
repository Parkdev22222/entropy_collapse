@@ -52,6 +52,30 @@ def entropy_from_logits(logits: torch.Tensor) -> torch.Tensor:
     return lse - (probs * logits).sum(dim=-1)
 
 
+def renyi2_from_logits(logits: torch.Tensor) -> torch.Tensor:
+    """Renyi-2 (collision) entropy in nats of ``softmax(logits)``, last dim.
+
+    ``H_2 = -log(sum_a p_a^2) = 2*lse(l) - lse(2*l)`` -- two logsumexp calls,
+    no ``log(p)``, shift-invariant, and ``0 <= H_2 <= H_shannon`` always.
+
+    Why it exists: Shannon entropy is dominated by tail mass.  A distribution
+    with one 0.9 token and two real alternatives scores 0.396; the same head
+    with 1000 never-sampled 1e-4 tokens scores 1.017 -- 2.5x apart on options
+    that will never be taken -- while Renyi-2 reads 0.205 vs 0.211.  Measured
+    on the sibling-discrimination task ``A_H`` actually performs, the
+    signal-to-tail-noise ratio is ~1.3:1 for Shannon and ~146:1 for Renyi-2,
+    which is the entire point of ``entropy_kind="renyi2"``.
+    """
+    return 2.0 * torch.logsumexp(logits, dim=-1) - torch.logsumexp(2.0 * logits, dim=-1)
+
+
+# What ``entropy_kind`` selects, here and in every consumer (forecast, Phase 1
+# measurement, calibration).  Producer and consumer must use the SAME kind --
+# a calibration fitted on one is meaningless applied to the other, which is
+# why the calibration JSON is stamped and checked.
+ENTROPY_FNS = {"shannon": entropy_from_logits, "renyi2": renyi2_from_logits}
+
